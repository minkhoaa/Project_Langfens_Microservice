{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "Issuer": "IssuerName",
    "Audience": "AudienceName",
    "SignKey": "${JwtSettings__SignKey}"
  },
  "AllowedHosts": "*",
