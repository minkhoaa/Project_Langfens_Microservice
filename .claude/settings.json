{
  "permissions": {
    "allow": [
      "dotnet",
      "dotnet-build",
      "dotnet-test",
      "dotnet-restore",
      "dotnet-format",
      "dotnet-ef",
      "docker",
      "docker-compose",
      "docker compose up",
      "docker compose down",
      "docker compose ps",
      "docker compose logs",
      "docker compose build",
      "python",
      "python3",
      "pip",
      "pip3",
      "npm",
      "npm install",
      "npm run",
      "git",
      "git checkout",
      "git switch",
      "git branch",
      "git status",
      "git diff",
      "git add",
      "git commit",
      "git stash",
      "git clean",
      "curl",
      "psql"
    ],
    "deny": [
      "git push",
      "git push --force",
      "docker push",
      "docker rmi",
      "sudo",
      "chmod +x"
    ]
  },
  "env": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_SKIP_FIRST_TIME_EXPERIENCE": "1",
    "ASPNETCORE_ENVIRONMENT": "Development"
  },
  "features": {
    "claudeCodeRecommendations": true,
    "documentation": {
      "includeAllFiles": false
    }
  }
}