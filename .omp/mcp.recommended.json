{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "context7-docs": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false,
      "instructions": false
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": false,
      "instructions": false
    },
    "postgres-exam": {
      "type": "stdio",
      "command": "postgres-mcp",
      "args": ["--access-mode=restricted"],
      "env": {
        "DATABASE_URI": "LANGFENS_EXAM_READONLY_DSN"
      },
      "enabled": false,
      "instructions": false
    },
    "postgres-attempt": {
      "type": "stdio",
      "command": "postgres-mcp",
      "args": ["--access-mode=restricted"],
      "env": {
        "DATABASE_URI": "LANGFENS_ATTEMPT_READONLY_DSN"
      },
      "enabled": false,
      "instructions": false
    },
    "qdrant": {
      "type": "stdio",
      "command": "mcp-server-qdrant",
      "env": {
        "QDRANT_URL": "LANGFENS_QDRANT_URL",
        "QDRANT_API_KEY": "LANGFENS_QDRANT_READONLY_API_KEY",
        "COLLECTION_NAME": "LANGFENS_QDRANT_COLLECTION",
        "EMBEDDING_MODEL": "LANGFENS_QDRANT_EMBEDDING_MODEL",
        "QDRANT_READ_ONLY": "true"
      },
      "enabled": false,
      "instructions": false
    }
  }
}
