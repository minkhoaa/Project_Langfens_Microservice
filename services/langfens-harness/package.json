{
	"name": "langfens-harness",
	"displayName": "langfens-harness",
	"private": true,
	"type": "module",
	"workspaces": ["packages/*"],
	"scripts": {
		"clean": "npm run clean --workspaces",
		"build": "npm run build -w langfens-telemetry && npm run build -w langfens-tui && npm run build -w langfens-codemode && npm run build -w langfens-mcp && npm run build -w langfens-ai && npm run build -w langfens-agent-core && npm run build -w langfens-harness-core",
		"build:offline": "npm run build",
		"typecheck": "tsc --noEmit",
		"check": "npm run typecheck",
		"test": "npm run test:smoke",
		"test:smoke": "node --import ./test/environment.mjs --test test/runtime.test.mjs test/isolation.test.mjs",
		"test:isolation": "node --import ./test/environment.mjs --test test/isolation.test.mjs",
		"test:container": "node --test test/container.test.mjs",
		"start": "node scripts/run.mjs",
		"dev": "node scripts/run.mjs --source",
		"build:native:darwin": "npm --prefix packages/tui run build:native:darwin",
		"build:native:linux": "npm --prefix packages/tui run build:native:linux",
		"build:native:win32": "npm --prefix packages/tui run build:native:win32"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"esbuild": "0.28.2",
		"shx": "0.3.4",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"version": "0.0.3",
	"overrides": {
		"protobufjs": "7.6.6"
	}
}
