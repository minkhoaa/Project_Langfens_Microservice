{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"langfens-telemetry": ["./packages/telemetry/src/index.ts"],
			"langfens-telemetry/*": ["./packages/telemetry/src/*.ts", "./packages/telemetry/src/*/index.ts"],
			"langfens-codemode": ["./packages/codemode/src/index.ts"],
			"langfens-codemode/worker": ["./packages/codemode/src/runtime/worker.ts"],
			"langfens-codemode/*": ["./packages/codemode/src/*.ts"],
			"langfens-mcp": ["./packages/mcp/src/index.ts"],
			"langfens-mcp/*": ["./packages/mcp/src/*/index.ts"],
			"langfens-ai": ["./packages/ai/src/index.ts"],
			"langfens-ai/oauth": ["./packages/ai/src/oauth.ts"],
			"langfens-ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"langfens-agent-core": ["./packages/agent/src/index.ts"],
			"langfens-harness-core": ["./packages/langfens-harness-core/src/index.ts"],
			"langfens-harness-core/*": ["./packages/langfens-harness-core/src/*"],
			"langfens-tui": ["./packages/tui/src/index.ts"],
			"langfens-tui/*": ["./packages/tui/src/*"]
		}
	},
	"include": ["packages/*/src/**/*"],
	"exclude": ["**/dist/**", "**/node_modules/**"]
}
