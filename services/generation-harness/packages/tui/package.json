	},
	"engines": {
		"node": ">=22.19.0"
	},
	"types": "./dist/index.d.ts",
	"dependencies": {
		"get-east-asian-width": "1.6.0",
		"marked": "18.0.11",
		"marked-cjk-friendly": "0.1.2"
	},
	"devDependencies": {
		"@xterm/headless": "5.5.0",
		"chalk": "6.0.0"
	}
