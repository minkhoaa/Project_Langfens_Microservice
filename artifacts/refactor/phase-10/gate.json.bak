      "name": "Hidden-key and evidence canary strictly absent from serialized payload and XML envelope",
      "passed": true,
      "details": "Verified allowlist DTO projection drops answer, correctOption, evidenceQuote, explanation, absenceAssessment, and canaries; untrusted student text safely escaped inside <prompt> tags; extra fields rejected at schema boundary."
    },
    "T10-02": {
      "name": "Key-swap request hash and cache key invariant with comparison outcome changed",
      "passed": true,
      "details": "Swapping expected answer from 'A' to 'B' leaves BlindSolverInput SHA-256 request hash and cache key 100% invariant, while comparison outcome flips from match to mismatch."
    },
    "T10-03": {
      "name": "TFNG and YNNG annotated pairs with whole-passage facts vs author stance distinction",
      "passed": true,
      "details": "Canonical TFNG (TRUE/FALSE/NOT GIVEN) and YNNG (YES/NO/NOT GIVEN) comparisons verified; UK/US spelling aliases normalized; fuzzy matching strictly rejected; question-type conditioned normalization enforced."
    },
    "T10-04": {
      "name": "MCQ and completion ambiguity detection by adversary creating HIGH blocker",
      "passed": true,
      "details": "Grounded multiple valid options detected by adversary with verified verbatim passage spans; adjudication produces AMBIGUOUS_DEFECTIVE verdict with HIGH severity."
    },
    "T10-05": {
      "name": "Unsupported adversary outside-knowledge claims rejected without failing valid items",
      "passed": true,
      "details": "Adversary allegations relying on outside knowledge without valid passage text citations are classified as unsupported and filtered out; valid test item is accepted with KEY_CONFIRMED."
    },
    "T10-06": {
      "name": "ProviderGateway fail-closed handling on timeout, malformed JSON, missing gateway, and budget exhaustion with SDK retry=0",
      "passed": true,
      "details": "Gateway timeout, malformed JSON, missing gateway, and budget exhaustion produce fail-closed non-pass outcomes under temporary RetryPolicy(max_attempts=1); real gateway + DurableStoreFake tests prove exact authority fencing propagation (context.authority.lease_owner & epoch), durable reservation/grant, tokens/wall-time reconciliation, and raw_text payload extraction."
    },
    "T10-07": {
      "name": "Student-visible cache keying and automatic invalidation on option, prompt, or passage mutation",
      "passed": true,
      "details": "Cache keys computed strictly from student-visible text, passage, instructions, prompt version, model, and config; mutating option text, prompt stem, or passage text automatically invalidates cache key."
    },
    "T10-08": {
      "name": "Model diversity profile tracing and correlated-review limitation tracking",
      "passed": true,
      "details": "Traces actual provider and model versions; dynamically refreshed from ProviderResponse; when same model is used across solver and adversary roles, correlated_review is set to true and statistical independence limitation note is attached."
    }
  },
