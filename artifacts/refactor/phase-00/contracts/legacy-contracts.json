{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Legacy Contracts Specification for Reading Paper Endpoints",
  "version": "1.0.0",
  "endpoints": {
    "getSources": {
      "path": "/v1/autogen/reading-paper/sources",
      "method": "GET",
      "queryParams": {
        "topic": { "type": "string", "minLength": 3, "maxLength": 120, "required": true }
      },
      "responses": {
        "200": {
          "mediaType": "application/json",
          "schema": {
            "type": "object",
            "required": ["sources", "selectedPmcids", "message"],
            "properties": {
              "sources": { "type": "array", "items": { "$ref": "#/definitions/ReadingSource" } },
              "selectedPmcids": { "type": "array", "items": { "type": "string" } },
              "message": { "type": ["string", "null"] }
            }
          }
        },
        "422": { "mediaType": "application/json", "description": "Validation error" },
        "503": { "mediaType": "application/json", "description": "Source network or API unavailable" }
      }
    },
    "postSource": {
      "path": "/v1/autogen/reading-paper/source",
      "method": "POST",
      "request": {
        "mediaType": "application/json",
        "schema": {
          "type": "object",
          "required": ["pmcid"],
          "properties": {
            "pmcid": { "type": "string", "pattern": "^PMC[0-9]+$" }
          }
        }
      },
      "responses": {
        "200": {
          "mediaType": "application/json",
          "schema": { "$ref": "#/definitions/ReadingSource" }
        },
        "422": { "mediaType": "application/json", "description": "Source license or content invalid (< 600 words, no CC license)" },
        "503": { "mediaType": "application/json", "description": "Europe PMC network failure" }
      }
    },
    "postSourceIngest": {
      "path": "/v1/autogen/reading-paper/source/ingest",
      "method": "POST",
      "request": {
        "mediaType": "application/json",
        "schema": {
          "type": "object",
          "required": ["payload"],
          "properties": {
            "payload": { "type": "string", "minLength": 1 },
            "type": { "type": "string", "enum": ["auto", "pmc", "url", "html", "markdown", "text"], "default": "auto" },
            "title": { "type": ["string", "null"] },
            "url": { "type": ["string", "null"] },
            "authors": { "type": ["string", "null"] },
            "license": { "type": ["string", "null"] }
          }
        }
      },
      "responses": {
        "200": {
          "mediaType": "application/json",
          "schema": { "$ref": "#/definitions/IngestedSource" }
        },
        "422": { "mediaType": "application/json", "description": "Ingestion failed (< 600 words, SSRF violation, invalid content)" },
        "503": { "mediaType": "application/json", "description": "External URL fetch failure" }
      }
    },
    "postSection": {
      "path": "/v1/autogen/reading-paper/section",
      "method": "POST",
      "request": {
        "mediaType": "application/json",
        "schema": {
          "type": "object",
          "required": ["topic", "index", "source"],
          "properties": {
            "topic": { "type": "string", "minLength": 3, "maxLength": 120 },
            "index": { "type": "integer", "minimum": 1, "maximum": 3 },
            "source": { "type": "object" },
            "provider": { "type": "string" }
          }
        }
      },
      "responses": {
        "200": {
          "variants": [
            {
              "condition": "Accept does not contain application/x-ndjson",
              "mediaType": "application/json",
              "schema": { "$ref": "#/definitions/ReadingGeneratedSection" }
            },
            {
              "condition": "Accept contains application/x-ndjson",
              "mediaType": "application/x-ndjson",
              "description": "Newline-delimited stream of events. Sequence: zero or more log events followed by exactly one terminal event (result or error).",
              "eventTypes": [
                {
                  "type": "log",
                  "properties": {
                    "type": { "const": "log" },
                    "timestamp": { "type": "string", "format": "date-time" },
                    "level": { "type": "string", "enum": ["Information", "Warning", "Error"] },
                    "message": { "type": "string" }
                  }
                },
                {
                  "type": "result",
                  "terminal": true,
                  "properties": {
                    "type": { "const": "result" },
                    "section": { "$ref": "#/definitions/ReadingGeneratedSection" }
                  }
                },
                {
                  "type": "error",
                  "terminal": true,
                  "properties": {
                    "type": { "const": "error" },
                    "httpStatus": { "type": "integer", "enum": [422, 502, 503] },
                    "message": { "type": "string" },
                    "traceback": { "type": "string" }
                  }
                }
              ]
            }
          ]
        },
        "422": { "description": "Unprocessable entity (e.g. source invalid)" },
        "502": { "description": "Generation pipeline or validation failure" },
        "503": { "description": "Source or provider network failure" }
      }
    }
  },
  "definitions": {
    "ReadingSource": {
      "type": "object",
      "required": ["pmcid", "title", "url", "license", "wordCount"],
      "properties": {
        "pmcid": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "license": { "type": "string" },
        "wordCount": { "type": "integer" },
        "authors": { "type": ["string", "null"] },
        "doi": { "type": ["string", "null"] },
        "openAlexId": { "type": ["string", "null"] },
        "topicId": { "type": ["string", "null"] },
        "sourceType": { "type": ["string", "null"] },
        "metadata": { "type": ["object", "null"] },
        "content": { "type": ["string", "null"] },
        "contentPreview": { "type": ["string", "null"] }
      }
    },
    "IngestedSource": {
      "allOf": [
        { "$ref": "#/definitions/ReadingSource" },
        {
          "type": "object",
          "required": ["sourceId", "sourceType"],
          "properties": {
            "sourceId": { "type": "string" },
            "sourceType": { "type": "string" }
          }
        }
      ]
    },
    "ReadingGeneratedQuestion": {
      "type": "object",
      "required": ["number", "prompt", "answer", "options", "evidenceQuote", "explanation"],
      "properties": {
        "number": { "type": "integer" },
        "prompt": { "type": "string" },
        "answer": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } },
        "evidenceQuote": { "type": "string" },
        "explanation": { "type": "string" }
      }
    },
    "ReadingGeneratedGroup": {
      "type": "object",
      "required": ["type", "instruction", "questions"],
      "properties": {
        "type": { "type": "string" },
        "instruction": { "type": "string" },
        "questions": { "type": "array", "items": { "$ref": "#/definitions/ReadingGeneratedQuestion" } }
      }
    },
    "ReadingGeneratedSection": {
      "type": "object",
      "required": ["title", "passage", "source", "groups"],
      "properties": {
        "title": { "type": "string" },
        "passage": { "type": "string" },
        "source": { "$ref": "#/definitions/ReadingSource" },
        "groups": { "type": "array", "items": { "$ref": "#/definitions/ReadingGeneratedGroup" } }
      }
    }
  }
}
