{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LangfensExamBlueprint",
  "description": "Versioned exam blueprint for IELTS Academic Reading (40 questions, 3 sections).",
  "type": "object",
  "properties": {
    "blueprintId": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "policyVersion": {
      "type": "string",
      "default": "v2.0.0"
    },
    "schemaVersion": {
      "type": "string",
      "default": "v2.0.0"
    },
    "totalQuestions": {
      "type": "integer",
      "const": 40
    },
    "targetWordCountMin": {
      "type": "integer",
      "const": 2150
    },
    "targetWordCountMax": {
      "type": "integer",
      "const": 2750
    },
    "sections": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "sectionId": {
            "type": "integer",
            "enum": [
              1,
              2,
              3
            ]
          },
          "topic": {
            "type": "string"
          },
          "targetWordCount": {
            "type": "integer",
            "minimum": 720,
            "maximum": 915
          },
          "evidenceGraphRef": {
            "type": "object",
            "properties": {
              "graphId": {
                "type": "string"
              },
              "sourcePackId": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "contentHash": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "const": "ACCEPTED"
              }
            },
            "required": [
              "graphId",
              "sourcePackId",
              "version",
              "contentHash",
              "status"
            ]
          },
          "questionSlots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "questionNumber": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 40
                },
                "sectionId": {
                  "type": "integer",
                  "enum": [
                    1,
                    2,
                    3
                  ]
                },
                "groupIndex": {
                  "type": "integer",
                  "enum": [
                    0,
                    1
                  ]
                },
                "questionType": {
                  "type": "string",
                  "enum": [
                    "TRUE_FALSE_NOT_GIVEN",
                    "SENTENCE_COMPLETION",
                    "MULTIPLE_CHOICE_SINGLE",
                    "SUMMARY_COMPLETION",
                    "YES_NO_NOT_GIVEN",
                    "SHORT_ANSWER"
                  ]
                },
                "targetDifficulty": {
                  "type": "object",
                  "properties": {
                    "level": {
                      "type": "string",
                      "enum": [
                        "FOUNDATION",
                        "MODERATE",
                        "ADVANCED"
                      ]
                    },
                    "rationale": {
                      "type": "string"
                    },
                    "isCalibrated": {
                      "type": "boolean",
                      "const": false
                    }
                  },
                  "required": [
                    "level",
                    "rationale",
                    "isCalibrated"
                  ]
                }
              },
              "required": [
                "questionNumber",
                "sectionId",
                "groupIndex",
                "questionType",
                "targetDifficulty"
              ]
            }
          }
        },
        "required": [
          "sectionId",
          "topic",
          "targetWordCount",
          "evidenceGraphRef",
          "questionSlots"
        ]
      }
    }
  },
  "required": [
    "blueprintId",
    "runId",
    "policyVersion",
    "schemaVersion",
    "totalQuestions",
    "sections"
  ]
}