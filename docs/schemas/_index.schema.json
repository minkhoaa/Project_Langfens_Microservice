{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://langfens.dev/schemas/_index.schema.json",
  "title": "Question",
  "description": "Discriminated union over all 21 Langfens question types.",
  "type": "object",
  "oneOf": [
    { "$ref": "multiple-choice-single.schema.json" },
    { "$ref": "multiple-choice-single-image.schema.json" },
    { "$ref": "multiple-choice-multiple.schema.json" },
    { "$ref": "true-false-not-given.schema.json" },
    { "$ref": "yes-no-not-given.schema.json" },
    { "$ref": "summary-completion.schema.json" },
    { "$ref": "table-completion.schema.json" },
    { "$ref": "note-completion.schema.json" },
    { "$ref": "form-completion.schema.json" },
    { "$ref": "sentence-completion.schema.json" },
    { "$ref": "short-answer.schema.json" },
    { "$ref": "audio-response.schema.json" },
    { "$ref": "diagram-label.schema.json" },
    { "$ref": "map-label.schema.json" },
    { "$ref": "matching-heading.schema.json" },
    { "$ref": "matching-information.schema.json" },
    { "$ref": "matching-features.schema.json" },
    { "$ref": "matching-endings.schema.json" },
    { "$ref": "classification.schema.json" },
    { "$ref": "flow-chart.schema.json" },
    { "$ref": "flow-chart-completion.schema.json" }
  ],
  "discriminator": {
    "propertyName": "type",
    "mapping": {
      "MULTIPLE_CHOICE_SINGLE": "multiple-choice-single.schema.json",
      "MULTIPLE_CHOICE_SINGLE_IMAGE": "multiple-choice-single-image.schema.json",
      "MULTIPLE_CHOICE_MULTIPLE": "multiple-choice-multiple.schema.json",
      "TRUE_FALSE_NOT_GIVEN": "true-false-not-given.schema.json",
      "YES_NO_NOT_GIVEN": "yes-no-not-given.schema.json",
      "SUMMARY_COMPLETION": "summary-completion.schema.json",
      "TABLE_COMPLETION": "table-completion.schema.json",
      "NOTE_COMPLETION": "note-completion.schema.json",
      "FORM_COMPLETION": "form-completion.schema.json",
      "SENTENCE_COMPLETION": "sentence-completion.schema.json",
      "SHORT_ANSWER": "short-answer.schema.json",
      "AUDIO_RESPONSE": "audio-response.schema.json",
      "DIAGRAM_LABEL": "diagram-label.schema.json",
      "MAP_LABEL": "map-label.schema.json",
      "MATCHING_HEADING": "matching-heading.schema.json",
      "MATCHING_INFORMATION": "matching-information.schema.json",
      "MATCHING_FEATURES": "matching-features.schema.json",
      "MATCHING_ENDINGS": "matching-endings.schema.json",
      "CLASSIFICATION": "classification.schema.json",
      "FLOW_CHART": "flow-chart.schema.json",
      "FLOW_CHART_COMPLETION": "flow-chart-completion.schema.json"
    }
  }
}
