{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://langfens.dev/schemas/classification.schema.json",
  "title": "Classification",
  "description": "Sort each item into one of several categories. Each item belongs to exactly one category.",
  "x-when-to-use": "When a list of items must each be sorted into exactly one of several categories.",
  "x-when-not-to-use": "Use MULTIPLE_CHOICE_MULTIPLE when items can belong to multiple categories. Use MATCHING_FEATURES when categories are exclusive but framed as features.",
  "x-typical-range": "{ \"items\": [5, 7, 10], \"categories\": [2, 3, 5] }",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "payload",
    "correctAnswer"
  ],
  "properties": {
    "type": {
      "const": "CLASSIFICATION"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    },
    "correctAnswer": {
      "$ref": "#/$defs/CorrectAnswer",
      "writeOnly": true
    },
    "rubric": {
      "$ref": "_shared.schema.json#/$defs/Rubric"
    }
  },
  "examples": [
    {
      "type": "CLASSIFICATION",
      "payload": {
        "id": "11111111-1111-4111-8111-111111111119",
        "skill": "READING",
        "difficulty": 3,
        "promptMd": "Classify each item as either Fruit or Vegetable.",
        "schemaVersion": "1.0.0",
        "items": [
          {
            "id": "item_1",
            "text": "Apple"
          },
          {
            "id": "item_2",
            "text": "Carrot"
          },
          {
            "id": "item_3",
            "text": "Spinach"
          },
          {
            "id": "item_4",
            "text": "Tomato"
          }
        ],
        "categories": [
          {
            "id": "cat_1",
            "label": "Fruit"
          },
          {
            "id": "cat_2",
            "label": "Vegetable"
          }
        ]
      },
      "correctAnswer": {
        "pairs": [
          {
            "itemId": "item_1",
            "categoryId": "cat_1"
          },
          {
            "itemId": "item_2",
            "categoryId": "cat_2"
          },
          {
            "itemId": "item_3",
            "categoryId": "cat_2"
          },
          {
            "itemId": "item_4",
            "categoryId": "cat_1"
          }
        ],
        "scoring": "all-or-nothing"
      }
    }
  ],
  "$defs": {
    "Payload": {
      "allOf": [
        {
          "$ref": "_shared.schema.json#/$defs/BasePayload"
        },
        {
          "type": "object",
          "required": [
            "items",
            "categories"
          ],
          "properties": {
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "text"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Stable identifier for this item. Pattern: ASCII letters, digits, underscore, hyphen, 1-16 chars.",
                    "pattern": "^[a-zA-Z0-9_-]{1,16}$"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Item text shown to the learner."
                  }
                }
              },
              "uniqueItems": true,
              "description": "Items to be classified.",
              "maxItems": 20
            },
            "categories": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "label"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Stable identifier for this category. Pattern: ASCII letters, digits, underscore, hyphen, 1-16 chars.",
                    "pattern": "^[a-zA-Z0-9_-]{1,16}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Category label shown to the learner."
                  }
                }
              },
              "uniqueItems": true,
              "description": "Candidate categories.",
              "maxItems": 10
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "CorrectAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pairs",
        "scoring"
      ],
      "properties": {
        "pairs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "itemId",
              "categoryId"
            ],
            "properties": {
              "itemId": {
                "type": "string",
                "description": "Id of the classified item. Pattern: ASCII letters, digits, underscore, hyphen, 1-16 chars.",
                "pattern": "^[a-zA-Z0-9_-]{1,16}$"
              },
              "categoryId": {
                "type": "string",
                "description": "Id of the category the item belongs to. Pattern: ASCII letters, digits, underscore, hyphen, 1-16 chars.",
                "pattern": "^[a-zA-Z0-9_-]{1,16}$"
              }
            }
          },
          "uniqueItems": true,
          "description": "Correct item-category assignments.",
          "maxItems": 20,
          "writeOnly": true
        },
        "scoring": {
          "$ref": "_shared.schema.json#/$defs/ScoringMode",
          "default": "afi",
          "description": "CLASSIFICATION scoring mode. Default 'afi' since each item belongs to exactly one category and is scored independently."
        }
      }
    }
  },
  "x-id-prefix": {
    "items": "item_",
    "categories": "cat_"
  }
}
