{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://langfens.dev/schemas/matching-information.schema.json",
  "title": "Matching Information",
  "description": "Match each question to the paragraph that contains the information it asks about.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "payload",
    "correctAnswer"
  ],
  "properties": {
    "type": {
      "const": "MATCHING_INFORMATION"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    },
    "correctAnswer": {
      "$ref": "#/$defs/CorrectAnswer",
      "writeOnly": true
    },
    "rubric": {
      "$ref": "_shared.schema.json#/$defs/Rubric"
    }
  },
  "examples": [
    {
      "type": "MATCHING_INFORMATION",
      "payload": {
        "id": "11111111-1111-4111-8111-111111111116",
        "skill": "READING",
        "difficulty": 4,
        "promptMd": "Match each piece of information with the paragraph (A, B, C) that contains it.",
        "schemaVersion": "1.0.0",
        "paragraphs": [
          {
            "id": "p_1",
            "label": "A"
          },
          {
            "id": "p_2",
            "label": "B"
          },
          {
            "id": "p_3",
            "label": "C"
          }
        ],
        "questions": [
          {
            "id": "q_1",
            "prompt": "A reference to the role of soil microbes."
          },
          {
            "id": "q_2",
            "prompt": "A statistic on urban canopy coverage."
          }
        ],
        "allowReuse": false
      },
      "correctAnswer": {
        "pairs": [
          {
            "questionId": "q_1",
            "paragraphId": "p_2"
          },
          {
            "questionId": "q_2",
            "paragraphId": "p_3"
          }
        ],
        "scoring": "all-or-nothing"
      }
    }
  ],
  "$defs": {
    "Payload": {
      "allOf": [
        {
          "$ref": "_shared.schema.json#/$defs/BasePayload"
        },
        {
          "type": "object",
          "required": [
            "paragraphs",
            "questions"
          ],
          "properties": {
            "paragraphs": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "label"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Stable identifier for this paragraph. Pattern: ASCII letters, digits, underscore, hyphen, 1-16 chars.",
                    "pattern": "^[a-zA-Z0-9_-]{1,16}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Display label shown next to the paragraph (e.g. 'A', 'B')."
                  }
                }
              },
              "uniqueItems": true,
              "description": "Candidate paragraphs.",
              "maxItems": 14
            },
            "questions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "prompt"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Stable identifier for this question item. Pattern: ASCII letters, digits, underscore, hyphen, 1-16 chars.",
                    "pattern": "^[a-zA-Z0-9_-]{1,16}$"
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Prompt text describing what information to locate."
                  }
                }
              },
              "uniqueItems": true,
              "description": "Question items to be matched to paragraphs.",
              "maxItems": 14
            },
            "allowReuse": {
              "type": "boolean",
              "default": false,
              "description": "Whether a paragraph may be the correct answer for more than one question."
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "CorrectAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pairs",
        "scoring"
      ],
      "properties": {
        "pairs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "questionId",
              "paragraphId"
            ],
            "properties": {
              "questionId": {
                "type": "string",
                "description": "Id of the question item. Pattern: ASCII letters, digits, underscore, hyphen, 1-16 chars.",
                "pattern": "^[a-zA-Z0-9_-]{1,16}$"
              },
              "paragraphId": {
                "type": "string",
                "description": "Id of the paragraph that contains the answer. Pattern: ASCII letters, digits, underscore, hyphen, 1-16 chars.",
                "pattern": "^[a-zA-Z0-9_-]{1,16}$"
              }
            }
          },
          "uniqueItems": true,
          "description": "Correct question-paragraph pairs.",
          "maxItems": 14,
          "writeOnly": true
        },
        "scoring": {
          "$ref": "_shared.schema.json#/$defs/ScoringMode"
        }
      }
    }
  }
}
