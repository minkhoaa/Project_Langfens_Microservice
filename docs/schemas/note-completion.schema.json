{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://langfens.dev/schemas/note-completion.schema.json",
  "title": "Note Completion",
  "description": "Complete a notes-style passage by filling one or more gaps from the listening audio.",
  "x-when-to-use": "When the prompt presents bulleted or partial notes with gaps the learner fills from a listening passage.",
  "x-when-not-to-use": "Use SUMMARY_COMPLETION for prose-style summaries. Use SENTENCE_COMPLETION for a single-gap sentence.",
  "x-typical-range": "{ \"gaps\": [2, 4, 6, 8] }",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "payload",
    "correctAnswer"
  ],
  "properties": {
    "type": {
      "const": "NOTE_COMPLETION"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    },
    "correctAnswer": {
      "$ref": "#/$defs/CorrectAnswer",
      "writeOnly": true
    },
    "rubric": {
      "$ref": "_shared.schema.json#/$defs/Rubric"
    }
  },
  "examples": [
    {
      "type": "NOTE_COMPLETION",
      "payload": {
        "id": "11111111-1111-4111-8111-111111111108",
        "skill": "LISTENING",
        "difficulty": 3,
        "promptMd": "Complete the notes below. Write **ONE WORD ONLY**.\n\nLibrary orientation\n- Borrow up to {{gap:gap_1}} books at a time.\n- Returns must be made by the {{gap:gap_2}} of each month.",
        "schemaVersion": "1.0.0",
        "gaps": [
          {
            "id": "gap_1",
            "wordLimit": 1,
            "expectedKind": "number"
          },
          {
            "id": "gap_2",
            "wordLimit": 1
          }
        ]
      },
      "correctAnswer": {
        "answers": {
          "gap_1": [
            "five"
          ],
          "gap_2": [
            "tenth"
          ]
        }
      }
    }
  ],
  "$defs": {
    "Payload": {
      "allOf": [
        {
          "$ref": "_shared.schema.json#/$defs/BasePayload"
        },
        {
          "type": "object",
          "required": [
            "gaps"
          ],
          "properties": {
            "gaps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "_shared.schema.json#/$defs/Gap"
              },
              "uniqueItems": true,
              "description": "Gaps embedded in the notes passage.",
              "maxItems": 10
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "CorrectAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answers"
      ],
      "properties": {
        "answers": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "description": "Map of gap id to accepted answers.",
          "writeOnly": true
        }
      }
    }
  }
}
